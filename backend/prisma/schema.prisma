generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DELETING
}

enum PageVisibility {
  PUBLIC
  DRAFT
  UNLISTED
}

enum EventType {
  VIEW
  CLICK
  FORM_SUBMIT
}

enum AuthTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum MediaAssetStatus {
  UPLOADING
  READY
}

model User {
  id              String        @id @default(uuid()) @db.Uuid
  email           String        @unique
  passwordHash    String
  status          AccountStatus @default(ACTIVE)
  emailVerifiedAt DateTime?
  locale          String        @default("en")
  timezone        String        @default("UTC")
  lastLoginAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  sessions        Session[]
  profiles        Profile[]
  authTokens      AuthToken[]
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique
  userId    String   @db.Uuid
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
}

model Profile {
  id          String    @id @default(uuid()) @db.Uuid
  ownerUserId String    @db.Uuid
  username    String    @unique
  displayName String
  role        Json
  bio         Json
  avatarUrl   String?
  verified    Boolean   @default(false)
  published   Boolean   @default(false)
  seo         Json
  socials     Json
  theme       Json
  version     Int       @default(1)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  owner       User      @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  pages       Page[]
  events      AnalyticsEvent[]
  forms       Form[]
  submissions FormSubmission[]
  subscribers Subscriber[]
  apiKeys     ApiKey[]
  dailyAnalytics AnalyticsDaily[]
  mediaAssets   MediaAsset[]
  @@index([ownerUserId, updatedAt])
}

model AuthToken {
  id         String        @id @default(uuid()) @db.Uuid
  userId     String        @db.Uuid
  type       AuthTokenType
  tokenHash  String        @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime      @default(now())
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, type, expiresAt])
}

model AnalyticsDaily {
  id               String   @id @default(uuid()) @db.Uuid
  profileId        String   @db.Uuid
  day              DateTime @db.Date
  views            Int      @default(0)
  uniqueVisitors   Int      @default(0)
  linkClicks       Int      @default(0)
  formSubmissions  Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  profile          Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  @@unique([profileId, day])
  @@index([profileId, day])
}

model MediaAsset {
  id          String           @id @default(uuid()) @db.Uuid
  profileId   String           @db.Uuid
  objectKey   String           @unique
  filename    String
  mimeType    String
  sizeBytes   Int
  status      MediaAssetStatus @default(UPLOADING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  profile     Profile          @relation(fields: [profileId], references: [id], onDelete: Cascade)
  @@index([profileId, createdAt])
}

model Page {
  id          String         @id @default(uuid()) @db.Uuid
  profileId   String         @db.Uuid
  title       Json
  slug        String
  description Json
  published   Boolean        @default(false)
  visibility  PageVisibility @default(DRAFT)
  position    Int            @default(0)
  version     Int            @default(1)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  profile     Profile        @relation(fields: [profileId], references: [id], onDelete: Cascade)
  blocks      Block[]
  @@unique([profileId, slug])
  @@index([profileId, position])
}

model Block {
  id        String   @id @default(uuid()) @db.Uuid
  pageId    String   @db.Uuid
  parentId  String?  @db.Uuid
  type      String
  title     Json?
  subtitle  Json?
  content   Json?
  url       String?
  config    Json
  position  Int      @default(0)
  visible   Boolean  @default(true)
  startsAt  DateTime?
  endsAt    DateTime?
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  parent    Block?   @relation("BlockChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children  Block[]  @relation("BlockChildren")
  @@index([pageId, position])
  @@index([parentId, position])
}

model AnalyticsEvent {
  id          String    @id @default(uuid()) @db.Uuid
  profileId   String    @db.Uuid
  pageId      String?   @db.Uuid
  blockId     String?   @db.Uuid
  type        EventType
  occurredAt  DateTime  @default(now())
  visitorHash String?
  referrer    String?
  utm         Json?
  userAgent   String?
  profile     Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  @@index([profileId, occurredAt])
  @@index([profileId, type, occurredAt])
}

model Form {
  id             String            @id @default(uuid()) @db.Uuid
  profileId      String            @db.Uuid
  pageId         String?           @db.Uuid
  blockId        String?           @db.Uuid
  title          Json
  description    Json?
  submitLabel    Json
  successMessage Json
  fields         Json
  enabled        Boolean           @default(true)
  version        Int               @default(1)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  profile        Profile           @relation(fields: [profileId], references: [id], onDelete: Cascade)
  submissions    FormSubmission[]
  @@index([profileId, updatedAt])
}

model FormSubmission {
  id          String   @id @default(uuid()) @db.Uuid
  formId      String   @db.Uuid
  profileId   String   @db.Uuid
  values      Json
  submittedAt DateTime @default(now())
  read        Boolean  @default(false)
  pageUrl     String?
  userAgent   String?
  form        Form    @relation(fields: [formId], references: [id], onDelete: Cascade)
  profile     Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  @@index([profileId, submittedAt])
}

enum SubscriberStatus {
  PENDING
  ACTIVE
  UNSUBSCRIBED
}

model Subscriber {
  id             String           @id @default(uuid()) @db.Uuid
  profileId      String           @db.Uuid
  email          String
  status         SubscriberStatus @default(PENDING)
  confirmationHash String?
  unsubscribeHash  String?
  createdAt      DateTime         @default(now())
  confirmedAt    DateTime?
  unsubscribedAt DateTime?
  source         Json
  profile        Profile          @relation(fields: [profileId], references: [id], onDelete: Cascade)
  @@unique([profileId, email])
  @@index([profileId, status, createdAt])
}

model ApiKey {
  id         String    @id @default(uuid()) @db.Uuid
  profileId  String    @db.Uuid
  name       String
  prefix     String
  tokenHash  String    @unique
  scopes     Json
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?
  profile    Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  @@index([profileId, revokedAt])
}
